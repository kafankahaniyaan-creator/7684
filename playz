<script>
    // URL Check & Instant Clean Before Render
    (function() {
        const params = new URLSearchParams(window.location.search);
        const codParam = params.get("cod");
        if (codParam) {
            localStorage.setItem('sf_custom_playlist', JSON.stringify({ type: 'url', val: codParam }));
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    })();

    const DEFAULT_PLAYLIST_URL = "https://raw.githubusercontent.com/kafankahaniyaan-creator/7684/refs/heads/main/playlist.m3u"; 
    const PLAYER_KEY = "XSuP4qMl+9tK17QNb+4+th2Pm9AWgMO/cYH8CI0HGGr7bdjo";
    const WATERMARK_URL = "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEihFKlu4Q43prqSQDjg9cJ46Kl7kEyUhOqBE6y-T7FB8afhgTk20fjHBM4FmS7JuUZT5irYq35jl9lKGHpoG7NjPL8rd4lOieKUYFA5ytp3b1GRX-m5ahrdyZR3A4DsaP5ZDu0TyNg1CZRdQQFrWKYMkBGjClIF6kvCXCz6egKkp_Qh9-UvaCr3LzOcqr4O/s1600/IPTVPLAYWatermark.png";
    const DEFAULT_IMAGE = "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEg3uAQMe3XrsK4kTn1Wz_4WhTTKUo3tKyh4C-ib6SP7LXTfWsHrpQB3SsYivkb4cwf6vUXaAke4XEXtG_cXimdPZwkxyZquoRNnUEjgc5_AnzJSLvfXTgOmnAi4JJo-I1k8c0dRxgrdRzOm78bllL2ppG-VBgUWt5jBZWo7W0wBL989FU5m-H3IUHIL5CY/s1600/LiveTVLD.png";

    const $container = document.getElementById("channelContainer");
    const $playerContainer = document.getElementById("playerContainer");
    const $loader = document.getElementById("loadingOverlay");
    const $mainLoader = document.getElementById("mainLoadingOverlay");
    const $relatedList = document.getElementById("relatedList");
    const $liveTitle = document.getElementById("liveTitle");
    const $liveLogo = document.getElementById("liveLogo");
    const $favSection = document.getElementById("favoritesSection");
    const $favGrid = document.getElementById("favoritesGrid");
    const $mainFavBtn = document.getElementById("mainFavBtn");
    const $searchInput = document.getElementById("searchInput");
    const $pillContainer = document.getElementById("pillContainer");
    const $moreDropdownMenu = document.getElementById("moreDropdownMenu");

    let allChannels = [];
    let jwplayerInstance = null;
    let currentPlayingChannel = null;
    let allCategoriesList = [];

    const saveToken = (t) => localStorage.setItem('saved_iptv_token', t);
    const getToken = () => localStorage.getItem('saved_iptv_token');

    function isValidDrmKey(val) {
        if (!val || typeof val !== 'string') return false;
        const clean = val.trim().toLowerCase();
        return clean !== '' && clean !== 'null' && clean !== 'undefined' && clean !== 'none';
    }

    const getFavs = () => {
        let favNames = JSON.parse(localStorage.getItem('my_iptv_favs')) || [];
        const currentGlobalToken = getToken();
        
        return favNames.map(name => {
            let ch = allChannels.find(c => c.name === name);
            if (!ch) return null;
            let cloned = { ...ch };
            if (currentGlobalToken) {
                cloned.tokenValue = currentGlobalToken;
                if (cloned.url && cloned.url.includes("__hdnea__=")) {
                    cloned.url = cloned.url.replace(/__hdnea__=[^&?#]*/, `__hdnea__=${currentGlobalToken}`);
                }
            }
            return cloned;
        }).filter(Boolean);
    };

    function updateFavUI() {
        const favs = getFavs();
        if ($favSection && $favGrid) {
            if (favs.length > 0 && allChannels.length > 0) {
                $favSection.style.display = 'block';
                $favGrid.innerHTML = '';
                favs.forEach(ch => $favGrid.appendChild(createBaseCard(ch, false)));
            } else {
                $favSection.style.display = 'none';
            }
        }
        if (currentPlayingChannel && $mainFavBtn) {
            let favNames = JSON.parse(localStorage.getItem('my_iptv_favs')) || [];
            const isFav = favNames.includes(currentPlayingChannel.name);
            $mainFavBtn.classList.toggle('active', isFav);
            const icon = document.getElementById('favIcon');
            if(icon) icon.textContent = isFav ? 'favorite' : 'favorite_border';
        }
    }

    function createBaseCard(ch, isRelated) {
        const div = document.createElement("div");
        div.className = isRelated ? "related-card channel-card" : "channel-card";
        div.tabIndex = 0;
        div.innerHTML = `
            <div class="channel-card__logo-box">
                <img src="${ch.logo}" onerror="this.src='${DEFAULT_IMAGE}'" loading="lazy">
            </div>
            <div class="channel-title-container">
                <span class="channel-card__title">${ch.name}</span>
            </div>
        `;
        div.onclick = () => {
            let targetCh = allChannels.find(c => c.name === ch.name) || ch;
            playChannel(targetCh);
        };
        return div;
    }

    function renderPills(channels) {
        if (!$pillContainer || !$moreDropdownMenu) return;
        const categories = new Set();
        channels.forEach(ch => { if(ch.category) categories.add(ch.category); });
        
        allCategoriesList = Array.from(categories).sort();

        const primaryCats = allCategoriesList.slice(0, 4);
        const dropdownCats = allCategoriesList.slice(4);

        $pillContainer.innerHTML = '<button class="pill active" onclick="filterByCategory(\'All\', this)">All</button>';
        primaryCats.forEach(cat => {
            const pill = document.createElement('button');
            pill.className = 'pill';
            pill.textContent = cat;
            pill.tabIndex = 0;
            pill.onclick = () => filterByCategory(cat, pill);
            $pillContainer.appendChild(pill);
        });

        $moreDropdownMenu.innerHTML = '';
        dropdownCats.forEach(cat => {
            const item = document.createElement('button');
            item.className = 'dropdown-item';
            item.textContent = cat;
            item.onclick = () => {
                filterByCategory(cat, null);
                toggleMoreDropdown();
            };
            $moreDropdownMenu.appendChild(item);
        });
        
        const moreWrapper = document.querySelector('.more-dropdown-wrapper');
        if (moreWrapper) {
            moreWrapper.style.display = dropdownCats.length > 0 ? 'inline-block' : 'none';
        }
    }

    function toggleMoreDropdown(e) {
        if (e) e.stopPropagation();
        if ($moreDropdownMenu) $moreDropdownMenu.classList.toggle('open');
    }

    window.onclick = function(event) {
        if (!event.target.closest('.more-dropdown-wrapper')) {
            if ($moreDropdownMenu) $moreDropdownMenu.classList.remove('open');
        }
    };

    function filterByCategory(category, el) {
        document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('active'));

        if (el) {
            el.classList.add('active');
        } else {
            document.querySelectorAll('.pill').forEach(p => {
                if (p.textContent === category) p.classList.add('active');
            });
            document.querySelectorAll('.dropdown-item').forEach(i => {
                if (i.textContent === category) i.classList.add('active');
            });
        }

        if (category === 'All') {
            renderChannelCards(allChannels);
        } else {
            const filtered = allChannels.filter(c => c.category === category);
            renderChannelCards(filtered);
        }
    }

    async function playChannel(channel, pushState = true) {
        if (!channel.url && channel.name) {
            const found = allChannels.find(c => c.name === channel.name);
            if (found) channel = found;
        }
        
        if (!channel.url) return;

        currentPlayingChannel = channel;
        
        if (jwplayerInstance) { try { jwplayerInstance.remove(); } catch(e){} jwplayerInstance = null; }
        
        const activeToken = channel.tokenValue || getToken() || "";
        if (activeToken) patchXHR(activeToken);

        if (pushState) {
            const cleanUrlName = channel.name.replace(/[^a-zA-Z0-9]/g, '');
            window.history.pushState({ playerOpen: true }, "", `?play=${cleanUrlName}`);
        } else {
            const cleanUrlName = channel.name.replace(/[^a-zA-Z0-9]/g, '');
            window.history.pushState({ playerOpen: true }, "", `?play=${cleanUrlName}`);
        }
        
        document.querySelector('header').style.display = "none";
        $container.style.display = "none";
        if($favSection) $favSection.style.display = "none";
        document.querySelector('.home-ad-container').style.display = "none";
        $playerContainer.style.display = "block";
        $loader.style.display = "flex";
        
        document.getElementById('playerTopTitle').textContent = channel.name;
        document.getElementById('playerTopLogo').src = channel.logo;
        $liveTitle.textContent = channel.name; 
        $liveLogo.src = channel.logo;
        updateFavUI();

        const hasValidKeys = isValidDrmKey(channel.keyId) && isValidDrmKey(channel.key);
        const isMpd = channel.url && channel.url.includes(".mpd");

        try {
            jwplayerInstance = jwplayer("player").setup({
                playlist: [{
                    file: channel.url, 
                    image: channel.logo,
                    type: isMpd ? "dash" : "hls",
                    drm: (hasValidKeys && isMpd) ? { clearkey: { keyId: channel.keyId, key: channel.key } } : undefined
                }],
                autostart: true, 
                width: "100%", 
                aspectratio: "16:9", 
                stretching: "exactfit",
                logo: { file: WATERMARK_URL, position: "bottom-right" }
            });

            jwplayerInstance.on("firstFrame", () => { $loader.style.display = "none"; });
            jwplayerInstance.on("play", () => { $loader.style.display = "none"; });
            jwplayerInstance.on("error", () => { $loader.style.display = "none"; });
        } catch (err) {
            $loader.style.display = "none";
        }

        renderRelatedChannels(channel);
        window.scrollTo(0, 0);  
    }

    function closePlayerUI() {
        if (jwplayerInstance) { try { jwplayerInstance.remove(); } catch(e){} jwplayerInstance = null; }

        $playerContainer.style.display = "none";
        document.querySelector('header').style.display = "block";
        $container.style.display = "grid"; 
        document.querySelector('.home-ad-container').style.display = "block";
        currentPlayingChannel = null;
        updateFavUI();
        window.history.replaceState({}, document.title, window.location.pathname);
    }

    window.onpopstate = () => { if ($playerContainer.style.display === "block") closePlayerUI(); };

    function patchXHR(token) {
        const origOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function(method, url) {
            if (url && typeof url === 'string' && !url.includes("__hdnea__")) {
                url += (url.includes("?") ? "&" : "?") + "__hdnea__=" + token;
            }
            return origOpen.apply(this, arguments);
        };
    }

    async function loadPlaylist() {
        if ($mainLoader) $mainLoader.style.display = "flex";

        const params = new URLSearchParams(window.location.search);
        const customConfig = localStorage.getItem('sf_custom_playlist');
        let targetUrl = params.get("url") || localStorage.getItem("cod_url") || DEFAULT_PLAYLIST_URL;
        let rawContent = null;

        if (customConfig) {
            try {
                const parsed = JSON.parse(customConfig);
                if (parsed.type === 'url' && parsed.val) targetUrl = parsed.val;
                if (parsed.type === 'raw' && parsed.val) rawContent = parsed.val;
            } catch(e) {}
        }

        const cacheKey = 'sf_instant_cache_' + targetUrl;
        const cachedRaw = localStorage.getItem(cacheKey);

        if (rawContent) {
            processPlaylistData(rawContent);
            if ($mainLoader) $mainLoader.style.display = "none";
            return;
        }

        if (cachedRaw) {
            processPlaylistData(cachedRaw);
            if ($mainLoader) $mainLoader.style.display = "none";
        }

        if (!targetUrl) {
            if ($mainLoader) $mainLoader.style.display = "none";
            return;
        }

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 4000);

        try {
            const res = await fetch(targetUrl, { cache: "no-store", signal: controller.signal });
            clearTimeout(timeoutId);
            const rawData = await res.text();

            if ($mainLoader) $mainLoader.style.display = "none";

            if (rawData && !rawData.trim().startsWith('<')) {
                localStorage.setItem(cacheKey, rawData);
                processPlaylistData(rawData);
            } else if (!cachedRaw) {
                throw new Error("Invalid format");
            }
        } catch (err) {
            clearTimeout(timeoutId);
            if ($mainLoader) $mainLoader.style.display = "none";

            if (!cachedRaw) {
                $container.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: var(--accent); padding: 40px; cursor: pointer;" onclick="loadPlaylist()">⚠️ Connection Slow. Click here to Retry.</div>`;
            }
        }
    }

    function processPlaylistData(rawData) {
        let finalChannels = [];
        const trimmed = rawData.trim();
        if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
            const jsonData = JSON.parse(trimmed);
            const list = Array.isArray(jsonData) ? jsonData : (jsonData.channels || []);
            
            finalChannels = list.map(item => {
                let extractedKeyId = item.keyId || item.key_id || null;
                let extractedKey = item.key || item.license_key || null;
                
                if (item.clearkey && typeof item.clearkey === 'object') {
                    const keys = Object.keys(item.clearkey);
                    if (keys.length > 0) {
                        extractedKeyId = keys[0];
                        extractedKey = item.clearkey[extractedKeyId];
                    }
                }

                if (item.drm && typeof item.drm === 'object') {
                    const keys = Object.keys(item.drm);
                    if (keys.length > 0) {
                        extractedKeyId = keys[0];
                        extractedKey = item.drm[extractedKeyId];
                    }
                }

                if (!isValidDrmKey(extractedKeyId)) extractedKeyId = null;
                if (!isValidDrmKey(extractedKey)) extractedKey = null;

                let inlineCookie = item.cookie || item.Cookie || "";
                if (inlineCookie.isEmpty && item.headers && typeof item.headers === 'object') {
                    inlineCookie = item.headers.cookie || item.headers.Cookie || "";
                }

                let streamUrl = item.mpd_url || item.mpd || item.url || item.link || item.stream_url || "";

                return {
                    name: item.name || item.title || "Unknown",
                    logo: item.logo || item.image || item.tvg_logo || "",
                    url: streamUrl,
                    category: item.category || item.group || "General",
                    keyId: extractedKeyId,
                    key: extractedKey,
                    tokenValue: inlineCookie.match(/__hdnea__=([^&?]+)/)?.[1] || getToken()
                };
            });
        } else {
            let m3uText = rawData;
            const savedToken = getToken();
            if (savedToken) m3uText = m3uText.replace(/(__hdnea__=)([^ \n\r\t"']*)/g, `__hdnea__=${savedToken}`);
            finalChannels = parseM3U(m3uText);
        }
        
        if (finalChannels.length > 0) {
            allChannels = finalChannels;
            renderChannelCards(allChannels);
            renderPills(allChannels);
            updateFavUI();
            
            const params = new URLSearchParams(window.location.search);
            let playParam = params.get("play"); 
            if (playParam) {
                let cleanQuery = decodeURIComponent(playParam).replace(/[^a-zA-Z0-9]/g, "").toLowerCase();
                
                const target = allChannels.find(c => {
                    let cCleanName = c.name.replace(/[^a-zA-Z0-9]/g, "").toLowerCase();
                    return cCleanName === cleanQuery;
                });

                if (target) playChannel(target, false);
            }
        }
    }

    function parseM3U(text) {
        const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
        const channels = []; let cur = {};
        for (const line of lines) {
            if (line.startsWith("#EXTINF")) {
                cur.name = line.split(",").pop().trim();
                cur.logo = (line.match(/tvg-logo="(.*?)"/) || [])[1] || "";
                cur.category = (line.match(/group-title="(.*?)"/) || [])[1] || "General";
            } else if (line.includes("license_key")) {
                const parts = line.split("=").pop().trim().split(":");
                if (parts.length === 2 && isValidDrmKey(parts[0]) && isValidDrmKey(parts[1])) {
                    [cur.keyId, cur.key] = parts;
                }
            } else if (/^https?:\/\//i.test(line)) {
                cur.url = line;
                cur.tokenValue = line.match(/__hdnea__=([^&?]+)/)?.[1] || getToken();
                channels.push({ ...cur }); cur = {};
            }
        }
        return channels;
    }

    function renderChannelCards(channels) {
        $container.innerHTML = "";
        if (channels.length === 0) return;
        channels.forEach(ch => $container.appendChild(createBaseCard(ch, false)));
    }

    function renderRelatedChannels(current) {
        $relatedList.innerHTML = "";
        allChannels.filter(ch => ch.name !== current.name).sort(() => 0.5 - Math.random()).slice(0, 16).forEach(ch => $relatedList.appendChild(createBaseCard(ch, true)));
    }

    function initializeApplication() {
        if (window.lucide) lucide.createIcons();
        jwplayer.key = PLAYER_KEY;
        loadPlaylist();
    }

    if ($mainFavBtn) $mainFavBtn.onclick = () => {
        if (!currentPlayingChannel) return;
        let favNames = JSON.parse(localStorage.getItem('my_iptv_favs')) || [];
        const idx = favNames.indexOf(currentPlayingChannel.name);
        if (idx > -1) {
            favNames.splice(idx, 1);
        } else {
            favNames.push(currentPlayingChannel.name);
        }
        localStorage.setItem('my_iptv_favs', JSON.stringify(favNames));
        updateFavUI();
    };

    if($searchInput) $searchInput.oninput = (e) => {
        const term = e.target.value.toLowerCase();
        renderChannelCards(allChannels.filter(c => c.name.toLowerCase().includes(term)));
        document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
        if(document.querySelector('.pill')) document.querySelector('.pill').classList.add('active');
    };

    function setTheme(name, btn) {
        if (!name || name==='default') delete document.body.dataset.theme;
        else document.body.dataset.theme = name;
        document.querySelectorAll('.theme-option').forEach(o=>o.classList.remove('selected'));
        if(btn) btn.classList.add('selected');
        localStorage.setItem('sf_theme', name);
    }
    function openThemeMonitor() { document.getElementById('themeModal').classList.add('open'); }
    function openThemeModal() { document.getElementById('themeModal').classList.add('open'); }
    function closeThemeModal(e) { if(!e||e.target===document.getElementById('themeModal')) document.getElementById('themeModal').classList.remove('open'); }

    function openPlaylistModal() { document.getElementById('playlistModal').classList.add('open'); }
    function closePlaylistModal(e) { if(!e || e.target === document.getElementById('playlistModal')) document.getElementById('playlistModal').classList.remove('open'); }

    function saveAndReloadPlaylist() {
        const urlVal = document.getElementById('customUrlInput').value.trim();
        const rawVal = document.getElementById('customRawInput').value.trim();
        let config = {};
        if (rawVal) {
            config = { type: 'raw', val: rawVal };
        } else if (urlVal) {
            config = { type: 'url', val: urlVal };
        } else {
            alert('Please enter a valid playlist URL or paste raw text.');
            return;
        }
        localStorage.setItem('sf_custom_playlist', JSON.stringify(config));
        closePlaylistModal();
        initializeApplication();
    }

    document.addEventListener("DOMContentLoaded", () => {
        const t = localStorage.getItem('sf_theme') || 'default';
        if (t && t !== 'default') {
            document.body.dataset.theme = t;
            const opt = document.querySelector(`[data-theme="${t}"]`);
            if(opt) opt.classList.add('selected');
        }
        initializeApplication();
    });  
</script>
</body>
</html>
